{
  "name": "plamo-page-translate",
  "version": "0.3.1",
  "private": true,
  "description": "Chrome MV3 full-page offline translation with PLaMo 3 Translate 2B GGUF + WebGPU",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:dom": "playwright test tests/paragraph.spec.mjs --workers=1 --reporter=line --output=browser-test-results"
  },
  "dependencies": {
    "@wllama/wllama": "3.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "esbuild": "0.25.12"
  },
  "engines": {
    "node": ">=20"
  }
}
